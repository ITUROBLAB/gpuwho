#!/bin/sh
set -e

case "$1" in
purge)
	# The event log is the only record of past usage, so it goes only on
	# an explicit purge -- never on a plain remove or an upgrade.
	rm -rf /var/lib/gpuwho
	rm -f /etc/gpuwho/ignore.conf
	rmdir /etc/gpuwho 2>/dev/null || true
	;;
remove)
	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
	;;
upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;
esac

exit 0
