#!/bin/sh
set -e

case "$1" in
remove | deconfigure)
	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
		systemctl disable --now gpuwho-collect.timer >/dev/null 2>&1 || true
		systemctl disable --now gpuwho-collect.service >/dev/null 2>&1 || true
		systemctl disable --now gpuwho-accounting.service >/dev/null 2>&1 || true
	fi
	;;
upgrade | failed-upgrade) ;;
esac

exit 0
